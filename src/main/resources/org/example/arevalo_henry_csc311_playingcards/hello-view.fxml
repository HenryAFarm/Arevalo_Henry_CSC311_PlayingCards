<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="18.0" stylesheets="@hello-view.css"
      styleClass="game-root" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.arevalo_henry_csc311_playingcards.HelloController">
    <padding>
        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0"/>
    </padding>

    <Label text="Card Game 24" styleClass="game-title"/>
    <Label text="Use each card value exactly once with +, -, *, /, and parentheses."
           styleClass="game-instructions"/>
    <HBox alignment="CENTER" spacing="10.0">
        <Button text="Find a solution" onAction="#onFindSolutionButtonClick"/>
        <TextField fx:id="solutionField" promptText="Solution Expression"
                   editable="false" prefWidth="280.0" maxWidth="280.0"
                   styleClass="solution-field"/>
        <Button text="Refresh" onAction="#onRefreshButtonClick"/>
    </HBox>
    <HBox alignment="CENTER" spacing="12.0">
        <StackPane styleClass="card-frame" minWidth="105.0" prefWidth="105.0" maxWidth="105.0"
                   minHeight="150.0" prefHeight="150.0" maxHeight="150.0">
            <ImageView fx:id="firstCardImage" fitHeight="146.0" fitWidth="101.0" preserveRatio="true"/>
        </StackPane>
        <StackPane styleClass="card-frame" minWidth="105.0" prefWidth="105.0" maxWidth="105.0"
                   minHeight="150.0" prefHeight="150.0" maxHeight="150.0">
            <ImageView fx:id="secondCardImage" fitHeight="146.0" fitWidth="101.0" preserveRatio="true"/>
        </StackPane>
        <StackPane styleClass="card-frame" minWidth="105.0" prefWidth="105.0" maxWidth="105.0"
                   minHeight="150.0" prefHeight="150.0" maxHeight="150.0">
            <ImageView fx:id="thirdCardImage" fitHeight="146.0" fitWidth="101.0" preserveRatio="true"/>
        </StackPane>
        <StackPane styleClass="card-frame" minWidth="105.0" prefWidth="105.0" maxWidth="105.0"
                   minHeight="150.0" prefHeight="150.0" maxHeight="150.0">
            <ImageView fx:id="fourthCardImage" fitHeight="146.0" fitWidth="101.0" preserveRatio="true"/>
        </StackPane>
    </HBox>
    <HBox alignment="CENTER" spacing="12.0">
        <Label text="Enter an expression:"/>
        <TextField fx:id="expressionField" promptText="Ex: (3 + 5) * (1 + 2)"
                   onAction="#onVerifyButtonClick" maxWidth="420.0"/>
        <Button text="Verify" onAction="#onVerifyButtonClick" defaultButton="true"/>
    </HBox>
    <Label fx:id="statusLabel" text=""
           wrapText="true" maxWidth="400.0"
           styleClass="status-message, status-box, status-neutral"/>
</VBox>
